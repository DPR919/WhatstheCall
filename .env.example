NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY
SITE_URL=https://www.whatsthecall.net
S3_REGION=us-west-2
S3_BUCKET_NAME=YOUR_BUCKET
# Production SSR fetches encrypted parameters using its AWS compute role.
# Leave these unset locally to use the local secret variables below.
# SSM_REGION=us-east-2
# SSM_PARAMETER_PREFIX=/whatsthecall/production
# Prefer an Amplify SSR compute role. Static credentials are for local use only.
S3_ACCESS_KEY_ID=LOCAL_ONLY
S3_SECRET_ACCESS_KEY=LOCAL_ONLY
# Generate a separate random server-only key for hashing rate-limit identities.
RATE_LIMIT_SECRET=SERVER_ONLY_RANDOM_VALUE
# Set only after verifying the ingress overwrites this header with the viewer IP.
# TRUSTED_CLIENT_IP_HEADER=cloudfront-viewer-address
# Both Turnstile keys must be set before deploying public authentication.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
TURNSTILE_SECRET_KEY=SERVER_ONLY
# Set true only when the same Turnstile secret is enabled in Supabase Auth.
SUPABASE_CAPTCHA_ENABLED=true
